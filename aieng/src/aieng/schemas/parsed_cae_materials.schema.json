{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aieng.dev/schemas/parsed_cae_materials.schema.json",
  "title": ".aieng parsed CAE materials",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "materials"
  ],
  "properties": {
    "format": {
      "type": "string",
      "const": "aieng.parsed_cae_materials"
    },
    "format_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "source_file": {
      "type": "string",
      "const": "simulation/cae_imports/source_solver_deck.inp"
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "elastic": {
            "type": "object",
            "required": [
              "youngs_modulus",
              "poisson_ratio"
            ],
            "properties": {
              "youngs_modulus": {
                "type": "number"
              },
              "poisson_ratio": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "density": {
            "type": "number"
          },
          "yield_strength": {
            "$comment": "MPa in the canonical unit system; the safety-factor field divides by it.",
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "parser": {
      "type": "object",
      "required": [
        "format",
        "scope"
      ],
      "properties": {
        "format": {
          "type": "string",
          "const": "calculix"
        },
        "scope": {
          "type": "string",
          "const": "phase_10a_minimal_cards"
        }
      },
      "additionalProperties": false
    },
    "authored_by": {
      "$comment": "The tool that authored this setup, e.g. `cae.setup_static`.",
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$comment": "The document must declare WHERE its content came from: `parser` + `source_file` for a deck that was parsed, `authored_by` for a setup the workbench wrote itself, or BOTH when a parsed deck was later edited by the authoring path \u2014 which is why this is anyOf rather than oneOf. What it may not do is declare neither, and an authored setup must not claim a `source_file` it never read: the synthesised source_solver_deck.inp supplies the mesh, not these loads. See #513.",
  "anyOf": [
    {
      "required": [
        "parser",
        "source_file"
      ]
    },
    {
      "required": [
        "authored_by"
      ]
    }
  ]
}
