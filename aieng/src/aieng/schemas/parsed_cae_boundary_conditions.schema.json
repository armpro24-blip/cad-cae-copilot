{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aieng.dev/schemas/parsed_cae_boundary_conditions.schema.json",
  "title": ".aieng parsed CAE boundary conditions",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "boundary_conditions"
  ],
  "properties": {
    "format": {
      "type": "string",
      "const": "aieng.parsed_cae_boundary_conditions"
    },
    "format_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "source_file": {
      "type": "string",
      "const": "simulation/cae_imports/source_solver_deck.inp"
    },
    "boundary_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "target",
          "dof_start",
          "dof_end",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "dof_start": {
            "type": "integer"
          },
          "dof_end": {
            "type": "integer"
          },
          "value": {
            "type": "number"
          },
          "type": {
            "$comment": "Read by the deck generator to pick the *BOUNDARY DOF range.",
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "parser": {
      "type": "object",
      "required": [
        "format",
        "scope"
      ],
      "properties": {
        "format": {
          "type": "string",
          "const": "calculix"
        },
        "scope": {
          "type": "string",
          "const": "phase_10a_minimal_cards"
        }
      },
      "additionalProperties": false
    },
    "authored_by": {
      "$comment": "The tool that authored this setup, e.g. `cae.setup_static`.",
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$comment": "The document must declare WHERE its content came from: `parser` + `source_file` for a deck that was parsed, `authored_by` for a setup the workbench wrote itself, or BOTH when a parsed deck was later edited by the authoring path \u2014 which is why this is anyOf rather than oneOf. What it may not do is declare neither, and an authored setup must not claim a `source_file` it never read: the synthesised source_solver_deck.inp supplies the mesh, not these loads. See #513.",
  "anyOf": [
    {
      "required": [
        "parser",
        "source_file"
      ]
    },
    {
      "required": [
        "authored_by"
      ]
    }
  ]
}
