{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aieng.dev/schemas/parsed_cae_loads.schema.json",
  "title": ".aieng parsed CAE loads",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "loads"
  ],
  "properties": {
    "format": {
      "type": "string",
      "const": "aieng.parsed_cae_loads"
    },
    "format_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "source_file": {
      "type": "string",
      "const": "simulation/cae_imports/source_solver_deck.inp"
    },
    "loads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "dof": {
            "type": "integer"
          },
          "value": {
            "type": "number"
          },
          "type": {
            "type": "string"
          },
          "value_n": {
            "$comment": "Magnitude of an authored force, with `direction`.",
            "type": "number"
          },
          "direction": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "dof",
              "value"
            ]
          },
          {
            "required": [
              "value_n",
              "direction"
            ]
          }
        ],
        "$comment": "Either form is complete: `dof` + `value` is how a solver deck states a load, `value_n` + `direction` is how an engineer does, and the deck generator decomposes the latter into the former."
      }
    },
    "parser": {
      "type": "object",
      "required": [
        "format",
        "scope"
      ],
      "properties": {
        "format": {
          "type": "string",
          "const": "calculix"
        },
        "scope": {
          "type": "string",
          "const": "phase_10a_minimal_cards"
        }
      },
      "additionalProperties": false
    },
    "authored_by": {
      "$comment": "The tool that authored this setup, e.g. `cae.setup_static`.",
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "$comment": "The document must declare WHERE its content came from: `parser` + `source_file` for a deck that was parsed, `authored_by` for a setup the workbench wrote itself, or BOTH when a parsed deck was later edited by the authoring path \u2014 which is why this is anyOf rather than oneOf. What it may not do is declare neither, and an authored setup must not claim a `source_file` it never read: the synthesised source_solver_deck.inp supplies the mesh, not these loads. See #513.",
  "anyOf": [
    {
      "required": [
        "parser",
        "source_file"
      ]
    },
    {
      "required": [
        "authored_by"
      ]
    }
  ]
}
