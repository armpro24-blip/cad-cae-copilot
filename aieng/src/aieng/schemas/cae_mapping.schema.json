{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aieng.dev/schemas/cae_mapping.schema.json",
  "title": ".aieng CAE mapping",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "source_files",
    "mappings",
    "notes"
  ],
  "properties": {
    "format": {
      "type": "string",
      "const": "aieng.cae_mapping"
    },
    "format_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "source_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cae_entity",
          "cae_type",
          "maps_to",
          "mapping_status",
          "mapping_method",
          "confidence"
        ],
        "properties": {
          "cae_entity": {
            "type": "string",
            "minLength": 1
          },
          "cae_type": {
            "type": "string",
            "enum": [
              "boundary_condition_target",
              "load_target"
            ]
          },
          "maps_to": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "feature_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "interface_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "fixed_support",
                      "load_application"
                    ]
                  },
                  "selection_source": {
                    "$comment": "How the face was chosen. Read by contextual_chat when explaining a binding to the user.",
                    "type": "string"
                  },
                  "target_pointers": {
                    "$comment": "@face:/@group: pointers the binding came from; read by the solver preflight.",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "load_type": {
                    "type": "string"
                  },
                  "value_n": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "direction": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "additionalProperties": false,
                "minProperties": 1
              }
            ]
          },
          "mapping_status": {
            "type": "string",
            "enum": [
              "mapped",
              "unmapped",
              "partially_mapped",
              "unresolved"
            ]
          },
          "mapping_method": {
            "type": "string",
            "enum": [
              "not_inferred_phase_10a",
              "user_provided",
              "resolved_from_pointer",
              "resolved_from_intent",
              "ai_generated"
            ],
            "$comment": "The first two are the CAE-import era's answers. The workbench now AUTHORS setups: `resolved_from_pointer` binds an explicit @face: pointer with no inference, `resolved_from_intent` resolves an engineering phrase (cae.setup_static), and `ai_generated` is an LLM-proposed binding."
          },
          "confidence": {
            "type": "string",
            "enum": [
              "none",
              "low",
              "medium",
              "high"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "face_ids": {
            "$comment": "Bound topology faces. Load-bearing: the deck generator turns these into NSET members, and binding re-verification compares them against the current topology.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "face_signatures": {
            "$comment": "What each bound face looked like when the mapping was written (surface type + normal). Deliberately not position or area \u2014 an edit is meant to move and resize faces. This is the evidence that lets a changed geometry re-verify instead of being refused.",
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "surface_type": {
                  "type": "string"
                },
                "normal": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mapping_summary": {
      "type": "object",
      "required": [
        "mapped_count",
        "unmapped_count"
      ],
      "properties": {
        "mapped_count": {
          "type": "integer",
          "minimum": 0
        },
        "unmapped_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "source_mapping_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "topology_hash": {
      "$comment": "Geometry revision the mapping was bound against; the solver preflight compares it before trusting the bindings.",
      "type": "string"
    },
    "ai_generated": {
      "type": "boolean"
    },
    "selection_pointer_syntax": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$comment": "Written by the CAE import path AND by the workbench's own authoring path (cae.setup_static -> normalize_cae_bindings). Both must fill the provenance fields: an authored mapping that records how the binding came to exist is strictly more informative than one that does not. See #513."
}
